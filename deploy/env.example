# copy to deploy/.env on the server and fill in; never commit the real file
# on/off settings take 1 or 0 only (not true, yes or on)
TGTRUST_BOT_ID=
TGTRUST_PSEUDONYM_KEY=
TGTRUST_TELEGRAM_ENV=production
# 1 = only Telegram Premium accounts can get a credential, 0 = everyone
TGTRUST_REQUIRE_PREMIUM=0
# public key (64 hex characters) of the arbiter who signs dispute rulings; empty = no arbiter
TGTRUST_ARBITER_PUBLIC_KEY=
TGTRUST_EPOCH=v1
TGTRUST_RATE_LIMIT=20
TGTRUST_TRUST_FORWARDED_FOR=1
TGTRUST_STAKE_CONTRACT=kQD0dNGo6GJnxq7Dc5HWcEfoBWI8UkUwZ6-w7gpwm8G11z-w
TGTRUST_TON_NETWORK=testnet
TGTRUST_TONCENTER_API_KEY=
TGTRUST_STAKE_CACHE_SECONDS=30
TGTRUST_BOT_TOKEN=
